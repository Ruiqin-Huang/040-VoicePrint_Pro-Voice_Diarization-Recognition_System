# 使用NVIDIA CUDA 11.8基础镜像
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TRANSFORMERS_CACHE=/app/pretrained_models \
    HF_HOME=/app/pretrained_models \
    MODEL_SCOPE_CACHE=/app/pretrained_models

# 一次性安装所有Python依赖
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel \
    # PyTorch 2.2.2 + CUDA 11.8
    && pip3 install --no-cache-dir \
    torch==2.2.2 \
    torchvision==0.17.2 \
    torchaudio==2.2.2 \
    --index-url https://download.pytorch.org/whl/cu118 \
    # 模型推理框架
    && pip3 install --no-cache-dir \
    transformers==4.56.0 \
    modelscope \
    accelerate \
    numpy<2.0.0 \
    # FastAPI框架
    fastapi \
    uvicorn \
    python-multipart \
    # HTTP客户端
    httpx>=0.25.0 \
    # 并发和异步
    asyncio>=3.4.3 \
    # 进度显示
    tqdm>=4.66.0 \
    # 配置管理
    pydantic>=2.0.0 \
    pydantic_settings>=2.0.0 \
    && pip3 cache purge \
    && rm -rf /tmp/* /var/tmp/*

# 创建模型缓存目录
RUN mkdir -p /app/pretrained_models \
    && mkdir -p /app/app \
    && chmod 777 /app/pretrained_models /app/app

# 设置默认启动命令
CMD ["python", "-m", "app.hy_main"]
