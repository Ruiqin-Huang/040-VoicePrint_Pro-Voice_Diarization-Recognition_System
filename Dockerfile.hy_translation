# 使用NVIDIA CUDA 11.8基础镜像
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-venv \
    git \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3.10 /usr/bin/python

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TRANSFORMERS_CACHE=/app/pretrained_models \
    HF_HOME=/app/pretrained_models \
    MODEL_SCOPE_CACHE=/app/pretrained_models

# 升级pip并安装Python依赖
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# 一次性安装所有Python依赖
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel \
    && pip3 install --no-cache-dir \
    torch==2.0.1 \
    torchvision==0.15.2 \
    torchaudio==2.0.2 \
    transformers==4.56.0 \
    modelscope \
    accelerate \
    uvicorn[standard] \
    fastapi \
    pydantic \
    python-multipart \
    asyncio \
    --index-url https://download.pytorch.org/whl/cu118 \
    && pip3 install --no-cache-dir \
    typing-extensions \
    httpx \
    aiofiles \
    sentencepiece \
    protobuf \
    && pip3 cache purge \
    && rm -rf /tmp/* /var/tmp/*

# 创建模型缓存目录
RUN mkdir -p /app/pretrained_models \
    && mkdir -p /app/app \
    && chmod 777 /app/pretrained_models /app/app

EXPOSE 8000

# 设置默认启动命令
CMD ["python", "-m", "app.hy_main"]
